[Unit]
Description=AMD GPU stats HTTP daemon (rocm-smi/amd-smi -> JSON)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thomas
WorkingDirectory=/home/thomas/workspace/AMD_GPU_Metric_DEAMON
ExecStart=/usr/bin/python3 /home/thomas/workspace/AMD_GPU_Metric_DEAMON/amd_gpu_stats.py
Restart=always
RestartSec=3
Environment=AMD_GPU_STATS_PORT=8791
Environment=AMD_GPU_STATS_POLL=3

[Install]
WantedBy=multi-user.target
